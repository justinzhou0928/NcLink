<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <Version>0.1.0</Version>
    <Authors>NcLink contributors</Authors>
    <Description>NC-Link（数控装备工业互联通讯协议）的 C# 客户端实现：MQTT 传输、设备模型解析、请求响应关联、采样订阅与 G 代码文件传输。</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/justinzhou0928/NcLink</RepositoryUrl>
    <PackageProjectUrl>https://github.com/justinzhou0928/NcLink</PackageProjectUrl>
    <Copyright>Copyright (c) 2026 JustiionZhou</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Condition="Exists('$(MSBuildThisFileDirectory)README.md')" />
  </ItemGroup>

</Project>
